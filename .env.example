# Copy to `.env` and fill in to use the LLM backend (offline heuristic needs none).
# Defaults target Fireworks AI, which exposes an OpenAI-compatible API.

# Route classification through the LLM backend:
PHISHPROBE_BACKEND=llm

# Fireworks AI (https://fireworks.ai) — create a key in the dashboard.
# List the models your key can access:
#   curl -H "Authorization: Bearer $PHISHPROBE_API_KEY" \
#        https://api.fireworks.ai/inference/v1/models
PHISHPROBE_API_KEY=fw_your_key_here
PHISHPROBE_BASE_URL=https://api.fireworks.ai/inference/v1
PHISHPROBE_MODEL=accounts/fireworks/models/gpt-oss-120b

# --- OpenAI instead of Fireworks ---
# PHISHPROBE_API_KEY=sk-your_key_here
# PHISHPROBE_BASE_URL=https://api.openai.com/v1
# PHISHPROBE_MODEL=gpt-4o-mini
